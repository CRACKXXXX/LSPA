rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── Noticias (foro) ─────────────────────────────────────────────────────
    match /noticias/{docId} {
      allow read: if true;
      allow write: if true;
    }
    
    // ── Vehicles (import/export) ─────────────────────────────────────────────
    // Allow all reads and writes to the vehicles collection
    // so the Import/Export feature works without authentication
    match /vehicles/{docId} {
      allow read, write: if true;
    }
    
    // ── Crews ────────────────────────────────────────────────────────────────
    match /crews/{docId} {
      allow read: if true;
      allow write: if true;
    }
    
    // ── Default: deny everything not explicitly allowed ────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
